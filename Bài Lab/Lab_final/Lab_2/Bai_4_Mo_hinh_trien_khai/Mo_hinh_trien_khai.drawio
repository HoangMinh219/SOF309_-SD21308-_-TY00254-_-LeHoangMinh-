<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="Mo hinh trien khai" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Web Browser&lt;/b&gt;&lt;br&gt;Công nghệ: HTML / CSS / JavaScript&lt;br&gt;Giao diện người dùng (GUI)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=20;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="260" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Web Server&lt;/b&gt;&lt;br&gt;Java Servlet / JSP&lt;br&gt;JDBC&lt;br&gt;Apache Tomcat" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=20;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="260" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Database Server&lt;/b&gt;&lt;br&gt;SQL Server&lt;br&gt;Lưu trữ dữ liệu (polycoffee)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=20;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="160" width="260" height="150" as="geometry"/></mxCell><mxCell id="c6" value="① HTTP request (GET/POST)" style="endArrow=classic;startArrow=none;html=1;fontSize=12;rounded=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="⑤ HTML response" style="endArrow=classic;startArrow=none;html=1;fontSize=12;rounded=0;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="② JDBC: câu lệnh SQL" style="endArrow=classic;startArrow=none;html=1;fontSize=12;rounded=0;" edge="1" parent="1" source="c4" target="